local function hangul(cp)
 if cp>=0x1100 and cp<=0x115f or cp>=0xa960 and cp<=0xa97c then return 'L'end
 if cp>=0x1160 and cp<=0x11a7 or cp>=0xd7b0 and cp<=0xd7c6 then return 'V'end
 if cp>=0x11a8 and cp<=0x11ff or cp>=0xd7cb and cp<=0xd7fb then return 'T'end
 if cp>=0xac00 and cp<=0xd7a3 then return (cp-0xac00)%28==0 and 'LV'or 'LVT'end
 return nil
end
function S.graphemeClass(cp)
 if cp==0xd then return 'CR'elseif cp==0xa then return 'LF'end
 if cp==0x200d then return 'ZWJ'end
 if cp>=0x1f1e6 and cp<=0x1f1ff then return 'RI'end
 if lookup(extend,cp)then return 'Extend'end
 if lookup(spacingMark,cp)then return 'SpacingMark'end
 if lookup(prepend,cp)then return 'Prepend'end
 if lookup(control,cp)then return 'Control'end
 local h=hangul(cp);if h then return h end
 if lookup(pictographic,cp)then return 'ExtPict'end
 return 'Any'
end
function S.graphemeBreak(classes,i)
 local a,b=classes[i],classes[i+1]
 if not a or not b then return true end
 if a=='CR'and b=='LF'then return false end
 if a=='CR'or a=='LF'or a=='Control'then return true end
 if b=='CR'or b=='LF'or b=='Control'then return true end
 if a=='L'and(b=='L'or b=='V'or b=='LV'or b=='LVT')then return false end
 if (a=='LV'or a=='V')and(b=='V'or b=='T')then return false end
 if (a=='LVT'or a=='T')and b=='T'then return false end
 if b=='Extend'or b=='ZWJ'then return false end
 if b=='SpacingMark'then return false end
 if a=='Prepend'then return false end
 if a=='ZWJ'and b=='ExtPict'then
  local j=i-1;while j>=1 and classes[j]=='Extend'do j-=1 end
  if j>=1 and classes[j]=='ExtPict'then return false end
 end
 if a=='RI'and b=='RI'then
  local count=0;local j=i;while j>=1 and classes[j]=='RI'do count+=1;j-=1 end
  if count%2==1 then return false end
 end
 return true
end
function S.graphemes(text)
 assert(utf8.len(text),'Texto UTF-8 inválido.')
 local points,starts,classes={},{},{}
 for position,cp in utf8.codes(text)do points[#points+1]=cp;starts[#starts+1]=position;classes[#classes+1]=S.graphemeClass(cp)end
 local out={};local first=1
 for i=1,#points do
  if S.graphemeBreak(classes,i)then
   local last=i<#points and starts[i+1]-1 or #text
   out[#out+1]=text:sub(starts[first],last);first=i+1
  end
 end
