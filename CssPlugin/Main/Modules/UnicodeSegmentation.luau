function S.lineClass(cp,opts)
 local c=lookup(lineClasses,cp)
 if not c then
  if lookup(extend,cp)or lookup(spacingMark,cp)or cp>=0xe0000 and cp<=0xe0fff then c='CM'
  elseif cp<0x20 or cp>=0x7f and cp<=0x9f or cp>=0x200e and cp<=0x200f or cp>=0x202a and cp<=0x202e or cp>=0x2060 and cp<=0x206f then c='BN'
  elseif cp>=0xac00 and cp<=0xd7a3 then c=(cp-0xac00)%28==0 and 'H2'or 'H3'
  elseif cp>=0x3400 and cp<=0x4dbf or cp>=0x4e00 and cp<=0x9fff or cp>=0xf900 and cp<=0xfaff or cp>=0x20000 and cp<=0x3fffd then c='ID'
  elseif cp>=0x1f000 and cp<=0x1faff then c='ID'
  else c='AL'end
 end
 if c=='AI'or c=='SG'or c=='XX'then c=(opts and opts.eastAsian)and 'ID'or 'AL'end
 if c=='SA'then c='AL'end
 if c=='CJ'then c=(opts and opts.strict)and 'NS'or 'ID'end
 return c
end
function S.lineBreaks(text,opts)
 assert(utf8.len(text),'Texto UTF-8 inválido.')
 opts=opts or {}
 local points,classes,starts={},{},{}
 for position,cp in utf8.codes(text)do points[#points+1]=cp;classes[#classes+1]=S.lineClass(cp,opts);starts[#starts+1]=position end
 local n=#points
 if n==0 then return {},points,classes end
 local eff={}
 for i=1,n do
  local c=classes[i]
  if i==1 and(c=='CM'or c=='ZWJ')then c='AL'end
  eff[i]=c
 end
 local base={}
 for i=1,n do
  local c=eff[i]
  if(c=='CM'or c=='ZWJ')and i>1 then
   local p=base[i-1]
   if p~='BK'and p~='CR'and p~='LF'and p~='NL'and p~='SP'and p~='ZW'then base[i]=p else base[i]='AL'end
  else base[i]=c end
