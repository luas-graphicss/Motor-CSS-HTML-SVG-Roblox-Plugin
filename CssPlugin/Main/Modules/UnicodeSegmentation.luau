 local out={}
 local function mandatory(i)out[i]='mandatory'end
 local function allowed(i)if out[i]==nil then out[i]='allowed'end end
 local function prohibited(i)if out[i]==nil then out[i]=false end end
 local function prevNonSpace(i)local j=i;while j>=1 and base[j]=='SP'do j-=1 end;return j end
 local riCount=0
