  local a,b=base[i],base[i+1];local rawB=eff[i+1]
  if base[i]=='RI'then riCount+=1 else riCount=0 end
  if a=='BK'then mandatory(i)
  elseif a=='CR'and b=='LF'then prohibited(i)
  elseif a=='CR'or a=='LF'or a=='NL'then mandatory(i)
  elseif b=='BK'or b=='CR'or b=='LF'or b=='NL'then prohibited(i)
  elseif b=='SP'or b=='ZW'then prohibited(i)
  elseif a=='ZW'then allowed(i)
  elseif rawB=='CM'or rawB=='ZWJ'then prohibited(i)
  elseif a=='ZWJ'and eff[i]=='ZWJ'then prohibited(i)
  elseif a=='WJ'or b=='WJ'then prohibited(i)
  elseif a=='GL'then prohibited(i)
  elseif b=='GL'and a~='SP'and a~='BA'and a~='HY'then prohibited(i)
  elseif b=='CL'or b=='CP'or b=='EX'or b=='IS'or b=='SY'then prohibited(i)
  elseif a=='OP'then prohibited(i)
  elseif a=='SP'and base[prevNonSpace(i)]=='OP'then prohibited(i)
  elseif a=='QU'and b=='OP'then prohibited(i)
  elseif a=='SP'and base[prevNonSpace(i)]=='QU'and b=='OP'then prohibited(i)
  elseif (a=='CL'or a=='CP')and b=='NS'then prohibited(i)
  elseif a=='SP'and(base[prevNonSpace(i)]=='CL'or base[prevNonSpace(i)]=='CP')and b=='NS'then prohibited(i)
  elseif a=='B2'and b=='B2'then prohibited(i)
  elseif a=='SP'and base[prevNonSpace(i)]=='B2'and b=='B2'then prohibited(i)
  elseif a=='SP'then allowed(i)
  elseif a=='QU'or b=='QU'then prohibited(i)
  elseif b=='CB'or a=='CB'then allowed(i)
  elseif b=='BA'or b=='HY'or b=='NS'then prohibited(i)
  elseif a=='BB'then prohibited(i)
  elseif a=='HL'and(b=='HY'or b=='BA')then prohibited(i)
  elseif (a=='HY'or a=='BA')and b=='AL'and base[i-1]=='HL'then prohibited(i)
  elseif a=='SY'and b=='HL'then prohibited(i)
  elseif (a=='AL'or a=='HL'or a=='NU'or a=='ID'or a=='EB'or a=='EM')and b=='IN'then prohibited(i)
  elseif (a=='AL'or a=='HL')and b=='NU'or a=='NU'and(b=='AL'or b=='HL')then prohibited(i)
  elseif a=='PR'and(b=='ID'or b=='EB'or b=='EM')or(a=='ID'or a=='EB'or a=='EM')and b=='PO'then prohibited(i)
  elseif (a=='PR'or a=='PO')and(b=='AL'or b=='HL')or(a=='AL'or a=='HL')and(b=='PR'or b=='PO')then prohibited(i)
  elseif (a=='PR'or a=='PO')and(b=='NU'or b=='OP'or b=='HY')or(a=='OP'or a=='HY')and b=='NU'or a=='NU'and(b=='NU'or b=='SY'or b=='IS'or b=='PO'or b=='PR')or (a=='CL'or a=='CP'or a=='SY'or a=='IS')and(b=='PO'or b=='PR')then prohibited(i)
  elseif (a=='SY'or a=='IS')and(b=='NU'or b=='SY'or b=='IS'or b=='CL'or b=='CP')and(function()local j=i;while j>=1 and(base[j]=='SY'or base[j]=='IS')do j-=1 end;return base[j]=='NU'end)()then prohibited(i)
  elseif a=='JL'and(b=='JL'or b=='JV'or b=='H2'or b=='H3')or(a=='JV'or a=='H2')and(b=='JV'or b=='JT')or(a=='JT'or a=='H3')and b=='JT'then prohibited(i)
  elseif (a=='JL'or a=='JV'or a=='JT'or a=='H2'or a=='H3')and(b=='IN'or b=='PO')or a=='PR'and(b=='JL'or b=='JV'or b=='JT'or b=='H2'or b=='H3')then prohibited(i)
  elseif (a=='AL'or a=='HL')and(b=='AL'or b=='HL')then prohibited(i)
  elseif a=='IS'and(b=='AL'or b=='HL')then prohibited(i)
  elseif (a=='AL'or a=='HL'or a=='NU')and b=='OP'or a=='CP'and(b=='AL'or b=='HL'or b=='NU')then prohibited(i)
  elseif a=='RI'and b=='RI'and riCount%2==1 then prohibited(i)
  elseif a=='EB'and b=='EM'then prohibited(i)
  else allowed(i)end
 end
 mandatory(n)
 return out,points,classes,starts
end
function S.canBreakAfter(left,right,opts)
 if not left or not right then return false end
 local text=left..right
 local marks=S.lineBreaks(text,opts)
 local count=utf8.len(left)
 return marks[count]=='allowed'or marks[count]=='mandatory'
end
